// #include <dt-bindings/zmk/bt.h>

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

// #include <dt-bindings/zmk/outputs.h>

&lt {
    flavor = "balanced";
    quick-tap-ms = <200>;
};

/ {
    behaviors {
        left_shift: left_shift {
            compatible = "zmk,behavior-mod-morph";
            label = "LEFT_SHIFT";
            bindings = <&kp LSHIFT>, <&caps_word>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT)>;
        };

        right_shift: right_shift {
            compatible = "zmk,behavior-mod-morph";
            label = "RIGHT_SHIFT";
            bindings = <&kp RSHIFT>, <&caps_word>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        lht: layer_hold_toggle {
            compatible = "zmk,behavior-hold-tap";
            label = "LHT";
            bindings = <&mo>, <&tog>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        s9: s9 {
            compatible = "zmk,behavior-mod-morph";
            label = "S9";
            bindings = <&kp N9>, <&kp GRAVE>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        s0: s0 {
            compatible = "zmk,behavior-mod-morph";
            label = "S0";
            bindings = <&kp N0>, <&kp LS(GRAVE)>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Base {
            bindings = <
&trans       &trans  &trans  &trans  &trans    &trans                                  &trans     &trans    &trans     &trans   &trans    &trans
&kp TAB      &kp Q   &kp W   &kp E   &kp R     &kp T                                   &kp Y      &kp U     &kp I      &kp O    &kp P     &kp BSPC
&kp LCTRL    &kp A   &kp S   &kp D   &kp F     &kp G                                   &kp H      &kp J     &kp K      &kp L    &kp SEMI  &kp SQT
&left_shift  &kp Z   &kp X   &kp C   &kp V     &kp B      &kp C_PLAY_PAUSE    &trans   &kp N      &kp M     &kp COMMA  &kp DOT  &kp FSLH  &right_shift
                     &trans  &trans  &kp LALT  &lt 2 ESC  &kp SPACE           &kp RET  &lt 3 DEL  &lht 3 5  &trans     &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };

        Game {
            bindings = <
&kp ESC  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5                         &trans  &trans  &trans  &trans  &trans  &trans
&trans   &trans  &trans  &trans  &trans  &trans                         &trans  &trans  &trans  &trans  &trans  &trans
&trans   &trans  &trans  &trans  &trans  &trans                         &trans  &trans  &trans  &trans  &trans  &trans
&trans   &trans  &trans  &trans  &trans  &trans       &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
                 &trans  &trans  &trans  &lt 2 GRAVE  &trans    &trans  &trans  &trans  &trans  &trans
            >;
        };

        Function {
            bindings = <
&trans  &trans  &trans   &trans   &trans   &trans                             &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp F1  &kp F2   &kp F3   &kp F4   &kp LA(F4)                         &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp F5  &kp F6   &kp F7   &kp F8   &kp PRINTSCREEN                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp F9  &kp F10  &kp F11  &kp F12  &kp LGUI         &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans   &trans   &trans   &trans           &trans    &trans  &trans  &trans  &trans  &trans
            >;
        };

        Navigation {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                    &trans    &trans     &trans     &trans     &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans    &trans     &trans     &trans     &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &kp LEFT  &kp DOWN   &kp UP     &kp RIGHT  &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans    &kp RSHFT  &kp RCTRL  &kp RALT   &kp RGUI  &trans
                &trans  &trans  &trans  &trans  &trans    &trans  &trans    &trans     &trans     &trans
            >;
        };

        Symbol {
            bindings = <
&trans  &trans         &trans     &trans            &trans        &trans                        &trans      &trans        &trans    &trans     &trans         &trans
&trans  &kp N1         &kp N2     &kp N3            &kp N4        &kp N5                        &kp N6      &kp N7        &kp N8    &s9        &s0            &trans
&trans  &kp LS(MINUS)  &kp MINUS  &kp LEFT_BRACKET  &kp LS(LBKT)  &kp LS(N9)                    &kp LS(N0)  &kp LS(RBKT)  &kp RBKT  &kp EQUAL  &kp LS(EQUAL)  &kp BSLH
&trans  &trans         &trans     &trans            &trans        &trans      &trans    &trans  &trans      &trans        &trans    &trans     &trans         &trans
                       &trans     &trans            &trans        &trans      &trans    &trans  &trans      &trans        &trans    &trans
            >;
        };

        Numpad {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                          &trans           &trans     &trans     &trans     &trans        &trans
&trans  &trans  &trans  &trans  &trans  &trans                          &kp KP_MULTIPLY  &kp KP_N7  &kp KP_N8  &kp KP_N9  &kp KP_MINUS  &trans
&trans  &trans  &trans  &trans  &trans  &trans                          &kp KP_DIVIDE    &kp KP_N4  &kp KP_N5  &kp KP_N6  &kp KP_PLUS   &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans        &kp KP_NUMLOCK   &kp KP_N1  &kp KP_N2  &kp KP_N3  &kp KP_DOT    &trans
                &trans  &trans  &trans  &trans  &trans    &kp KP_ENTER  &kp KP_N0        &trans     &trans     &trans
            >;
        };

        Comma {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans     &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans     &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans     &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &kp COMMA  &trans
                &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
            >;
        };

        Meta {
            bindings = <
&trans  &trans  &trans          &trans    &trans  &trans                    &trans  &trans  &trans      &trans          &trans           &trans
&trans  &trans  &trans          &trans    &trans  &trans                    &trans  &trans  &kp INSERT  &trans          &kp PAUSE_BREAK  &trans
&trans  &trans  &kp SCROLLLOCK  &trans    &trans  &tog 1                    &trans  &trans  &trans      &kp SCROLLLOCK  &trans           &trans
&trans  &trans  &trans          &kp CAPS  &trans  &trans  &trans    &trans  &trans  &trans  &tog 8      &tog 8          &trans           &trans
                &trans          &trans    &trans  &trans  &trans    &trans  &trans  &trans  &trans      &trans
            >;
        };

        Toggle_Comma {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
            >;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        META {
            if-layers = <2 3>;
            then-layer = <7>;
        };

        Func-Num {
            if-layers = <2>;
            then-layer = <5>;
        };

        NavSym {
            if-layers = <3>;
            then-layer = <4>;
        };

        ToggleComma {
            if-layers = <5 8>;
            then-layer = <6>;
        };
    };
};

&sensors { triggers-per-rotation = <30>; };

&left_encoder { steps = <60>; };

&right_encoder { steps = <60>; };
