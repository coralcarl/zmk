// #include <dt-bindings/zmk/bt.h>

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

// #include <dt-bindings/zmk/outputs.h>

&lt {
    flavor = "balanced";
    quick-tap-ms = <200>;
};

/ {
    behaviors {
        left_shift: left_shift {
            compatible = "zmk,behavior-mod-morph";
            label = "LEFT_SHIFT";
            bindings = <&kp LSHIFT>, <&caps_word>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT)>;
        };

        right_shift: right_shift {
            compatible = "zmk,behavior-mod-morph";
            label = "RIGHT_SHIFT";
            bindings = <&kp RSHIFT>, <&caps_word>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        esc_td: esc_td {
            compatible = "zmk,behavior-tap-dance";
            label = "ESC_TD";
            #binding-cells = <0>;
            bindings = <&kp ESC>, <&mo 2>;
        };

        del_td: del_td {
            compatible = "zmk,behavior-tap-dance";
            label = "DEL_TD";
            #binding-cells = <0>;
            bindings = <&lt 3 DEL>, <&mo 4>;
        };

        hml: hml {
            compatible = "zmk,behavior-hold-tap";
            label = "HML";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-key-positions = <34 35 43 44 45 46 47 48 49 55 56 57 58 59 6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 44 45 46 47 54 53 52>;
            hold-trigger-on-release;
        };

        hmr: hmr {
            compatible = "zmk,behavior-hold-tap";
            label = "HMR";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-on-release;
            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38 39 40 41 42 50 51 52 53 54 55 56 57>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Alpha {
            bindings = <
&trans     &trans  &trans  &trans  &trans  &trans                               &trans  &trans     &trans     &trans   &trans    &trans
&kp TAB    &kp Q   &kp W   &kp E   &kp R   &kp T                                &kp Y   &kp U      &kp I      &kp O    &kp P     &kp BSPC
&kp ESC    &kp A   &kp S   &kp D   &kp F   &kp G                                &kp H   &kp J      &kp K      &kp L    &kp SEMI  &kp SQT
&kp GRAVE  &kp Z   &kp X   &kp C   &kp V   &kp B   &kp C_PLAY_PAUSE    &trans   &kp N   &kp M      &kp COMMA  &kp DOT  &kp FSLH  &kp BSLH
                   &trans  &trans  &mo 4   &mo 2   &kp SPACE           &kp RET  &mo 3   &lt 5 DEL  &trans     &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };

        Game {
            bindings = <
&kp ESC  &kp N1  &kp N2  &kp N3  &kp N4    &kp N5                         &trans  &trans  &trans  &trans  &trans  &trans
&trans   &trans  &trans  &trans  &trans    &trans                         &trans  &trans  &trans  &trans  &trans  &trans
&trans   &trans  &trans  &trans  &trans    &trans                         &trans  &trans  &trans  &trans  &trans  &trans
&trans   &trans  &trans  &trans  &trans    &trans       &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
                 &trans  &trans  &kp LALT  &lt 0 GRAVE  &trans    &trans  &trans  &trans  &trans  &trans
            >;
        };

        Numpad {
            bindings = <
&trans  &trans  &trans  &trans           &trans  &trans                        &trans     &trans      &trans  &trans  &trans     &trans
&trans  &trans  &trans  &trans           &trans  &kp LA(F4)                    &kp LBKT   &kp N7      &kp N8  &kp N9  &kp RBKT   &trans
&trans  &trans  &trans  &trans           &trans  &kp F5                        &kp MINUS  &kp N4      &kp N5  &kp N6  &kp EQUAL  &trans
&trans  &trans  &trans  &kp PRINTSCREEN  &trans  &trans      &trans    &trans  &trans     &kp N1      &kp N2  &kp N3  &trans     &trans
                &trans  &trans           &trans  &trans      &trans    &trans  &kp N0     &kp KP_DOT  &trans  &trans
            >;
        };

        Nav {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                    &trans    &trans         &trans       &trans     &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &kp HOME  &kp PAGE_DOWN  &kp PAGE_UP  &kp END    &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &kp LEFT  &kp DOWN       &kp UP       &kp RIGHT  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans    &trans         &trans       &trans     &trans  &trans
                &trans  &trans  &trans  &trans  &trans    &trans  &trans    &trans         &trans       &trans
            >;
        };

        Func {
            bindings = <
&trans  &trans  &trans   &trans   &trans   &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp F1  &kp F2   &kp F3   &kp F4   &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp F5  &kp F6   &kp F7   &kp F8   &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp F9  &kp F10  &kp F11  &kp F12  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans   &trans   &trans   &trans  &trans    &trans  &trans  &trans  &trans  &trans
            >;
        };

        Meta {
            bindings = <
&trans  &trans  &trans          &trans    &trans  &trans                    &trans          &trans  &trans      &trans          &trans           &trans
&trans  &trans  &trans          &trans    &trans  &trans                    &trans          &trans  &kp INSERT  &trans          &kp PAUSE_BREAK  &trans
&trans  &trans  &kp SCROLLLOCK  &trans    &trans  &tog 1                    &trans          &trans  &trans      &kp SCROLLLOCK  &trans           &trans
&trans  &trans  &trans          &kp CAPS  &trans  &trans  &trans    &trans  &kp KP_NUMLOCK  &trans  &trans      &trans          &trans           &trans
                &trans          &trans    &trans  &trans  &trans    &trans  &trans          &trans  &trans      &trans
            >;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        a {
            if-layers = <3 3>;
            then-layer = <5>;
        };
    };
};

&sensors { triggers-per-rotation = <30>; };

&left_encoder { steps = <60>; };

&right_encoder { steps = <60>; };
