// #include <dt-bindings/zmk/bt.h>

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

// #include <dt-bindings/zmk/outputs.h>

&lt {
    flavor = "balanced";
    quick-tap-ms = <200>;
};

/ {
    behaviors {
        left_shift: left_shift {
            compatible = "zmk,behavior-mod-morph";
            label = "LEFT_SHIFT";
            bindings = <&kp LSHIFT>, <&caps_word>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT)>;
        };

        right_shift: right_shift {
            compatible = "zmk,behavior-mod-morph";
            label = "RIGHT_SHIFT";
            bindings = <&kp RSHIFT>, <&caps_word>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Alpha {
            bindings = <
&trans     &trans  &trans  &trans  &trans    &trans                                  &trans  &trans        &trans     &trans   &trans    &trans
&kp TAB    &kp Q   &kp W   &kp E   &kp R     &kp T                                   &kp Y   &kp U         &kp I      &kp O    &kp P     &kp BSPC
&kp LCTRL  &kp A   &kp S   &kp D   &kp F     &kp G                                   &kp H   &kp J         &kp K      &kp L    &kp SEMI  &kp SQT
&kp LSHFT  &kp Z   &kp X   &kp C   &kp V     &kp B      &kp C_PLAY_PAUSE    &trans   &kp N   &kp M         &kp COMMA  &kp DOT  &kp FSLH  &kp RSHFT
                   &trans  &trans  &kp LALT  &lt 2 ESC  &kp SPACE           &kp RET  &mo 3   &mt LGUI DEL  &trans     &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };

        Game {
            bindings = <
&kp ESC  &kp N1  &kp N2  &kp N3  &kp N4    &kp N5                         &trans  &trans  &trans  &trans  &trans  &trans
&trans   &trans  &trans  &trans  &trans    &trans                         &trans  &trans  &trans  &trans  &trans  &trans
&trans   &trans  &trans  &trans  &trans    &trans                         &trans  &trans  &trans  &trans  &trans  &trans
&trans   &trans  &trans  &trans  &trans    &trans       &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
                 &trans  &trans  &kp LALT  &lt 2 GRAVE  &trans    &trans  &trans  &trans  &trans  &trans
            >;
        };

        Num {
            bindings = <
&trans  &trans  &trans   &trans   &trans   &trans                             &trans     &trans      &trans  &trans  &trans     &trans
&trans  &kp F1  &kp F2   &kp F3   &kp F4   &kp LA(F4)                         &kp LBKT   &kp N7      &kp N8  &kp N9  &kp RBKT   &trans
&trans  &kp F5  &kp F6   &kp F7   &kp F8   &kp PRINTSCREEN                    &kp MINUS  &kp N4      &kp N5  &kp N6  &kp EQUAL  &kp BACKSLASH
&trans  &kp F9  &kp F10  &kp F11  &kp F12  &kp LGUI         &trans    &trans  &kp GRAVE  &kp N1      &kp N2  &kp N3  &trans     &trans
                &trans   &trans   &trans   &trans           &trans    &trans  &kp N0     &kp KP_DOT  &trans  &trans
            >;
        };

        Nav {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                    &trans    &trans         &trans       &trans     &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &kp HOME  &kp PAGE_DOWN  &kp PAGE_UP  &kp END    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &kp LEFT  &kp DOWN       &kp UP       &kp RIGHT  &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans    &kp RSHFT      &kp RCTRL    &kp RALT   &kp RGUI  &trans
                &trans  &trans  &trans  &mo 4   &trans    &trans  &trans    &trans         &trans       &trans
            >;
        };

        Meta {
            bindings = <
&trans  &trans  &trans          &trans    &trans  &trans                    &trans          &trans  &trans      &trans          &trans           &trans
&trans  &trans  &trans          &trans    &trans  &trans                    &trans          &trans  &kp INSERT  &trans          &kp PAUSE_BREAK  &trans
&trans  &trans  &kp SCROLLLOCK  &trans    &trans  &tog 1                    &trans          &trans  &trans      &kp SCROLLLOCK  &trans           &trans
&trans  &trans  &trans          &kp CAPS  &trans  &trans  &trans    &trans  &kp KP_NUMLOCK  &trans  &trans      &trans          &trans           &trans
                &trans          &trans    &trans  &trans  &trans    &trans  &trans          &trans  &trans      &trans
            >;
        };
    };

    conditional_layers { compatible = "zmk,conditional-layers"; };
};

&sensors { triggers-per-rotation = <30>; };

&left_encoder { steps = <60>; };

&right_encoder { steps = <60>; };
