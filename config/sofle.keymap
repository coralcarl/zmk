// #include <dt-bindings/zmk/bt.h>

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

// #include <dt-bindings/zmk/outputs.h>

&lt {
    flavor = "balanced";
    quick-tap-ms = <200>;
};

/ {
    behaviors {
        left_shift: left_shift {
            compatible = "zmk,behavior-mod-morph";
            label = "LEFT_SHIFT";
            bindings = <&kp LSHIFT>, <&caps_word>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT)>;
        };

        right_shift: right_shift {
            compatible = "zmk,behavior-mod-morph";
            label = "RIGHT_SHIFT";
            bindings = <&kp RSHIFT>, <&caps_word>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        holdtoggle: holdtoggle {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLDTOGGLE";
            bindings = <&kp>, <&tog>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Alpha {
            bindings = <
&trans       &trans  &trans  &trans  &trans              &trans                                  &trans     &trans    &trans     &trans   &trans    &trans
&kp TAB      &kp Q   &kp W   &kp E   &kp R               &kp T                                   &kp Y      &kp U     &kp I      &kp O    &kp P     &kp BSPC
&kp LCTRL    &kp A   &kp S   &kp D   &kp F               &kp G                                   &kp H      &kp J     &kp K      &kp L    &kp SEMI  &kp SQT
&left_shift  &kp Z   &kp X   &kp C   &kp V               &kp B      &kp C_PLAY_PAUSE    &trans   &kp N      &kp M     &kp COMMA  &kp DOT  &kp FSLH  &right_shift
                     &trans  &trans  &holdtoggle LALT 6  &lt 3 ESC  &kp SPACE           &kp RET  &lt 3 DEL  &kp RGUI  &trans     &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };

        Game {
            bindings = <
&kp ESC  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5                         &trans  &trans  &trans  &trans  &trans  &trans
&trans   &trans  &trans  &trans  &trans  &trans                         &trans  &trans  &trans  &trans  &trans  &trans
&trans   &trans  &trans  &trans  &trans  &trans                         &trans  &trans  &trans  &trans  &trans  &trans
&trans   &trans  &trans  &trans  &trans  &trans       &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
                 &trans  &trans  &trans  &lt 3 GRAVE  &trans    &trans  &trans  &trans  &trans  &trans
            >;
        };

        CommaToggle {
            bindings = <
&trans  &trans  &trans  &trans  &trans              &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans              &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans              &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans              &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &holdtoggle LALT 7  &trans  &trans    &trans  &trans  &trans  &trans  &trans
            >;
        };

        Num {
            bindings = <
&trans     &trans    &trans    &trans     &trans     &trans                    &trans  &trans     &trans     &trans    &trans    &trans
&kp GRAVE  &kp N1    &kp N2    &kp N3     &kp N4     &kp N5                    &kp N6  &kp N7     &kp N8     &kp N9    &kp N0    &kp BSLH
&trans     &mo 4     &kp LALT  &kp LCTRL  &kp LSHFT  &trans                    &trans  &kp RSHFT  &kp RCTRL  &kp RALT  &mo 5     &trans
&trans     &kp LGUI  &trans    &trans     &trans     &trans  &trans    &trans  &trans  &trans     &trans     &trans    &kp RGUI  &trans
                     &trans    &trans     &trans     &trans  &trans    &trans  &trans  &mo 8      &trans     &trans
            >;
        };

        Extras {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                             &trans  &trans     &trans     &trans    &trans    &trans
&trans  &trans  &trans  &trans  &kp F5  &kp LA(F4)                         &trans  &kp MINUS  &kp EQUAL  &kp LBKT  &kp RBKT  &trans
&trans  &trans  &trans  &trans  &trans  &kp PRINTSCREEN                    &trans  &trans     &trans     &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans           &trans    &trans  &trans  &trans     &trans     &trans    &trans    &trans
                &trans  &trans  &trans  &trans           &trans    &trans  &trans  &trans     &trans     &trans
            >;
        };

        NavFn {
            bindings = <
&trans  &trans  &trans   &trans   &trans   &trans                    &trans    &trans    &trans  &trans     &trans  &trans
&trans  &kp F1  &kp F2   &kp F3   &kp F4   &trans                    &trans    &trans    &trans  &trans     &trans  &trans
&trans  &kp F5  &kp F6   &kp F7   &kp F8   &trans                    &kp LEFT  &kp DOWN  &kp UP  &kp RIGHT  &trans  &trans
&trans  &kp F9  &kp F10  &kp F11  &kp F12  &trans  &trans    &trans  &trans    &trans    &trans  &trans     &trans  &trans
                &trans   &trans   &trans   &trans  &trans    &trans  &trans    &trans    &trans  &trans
            >;
        };

        Numpad {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                          &trans           &trans     &trans     &trans     &trans        &trans
&tog 6  &trans  &trans  &trans  &trans  &trans                          &kp KP_MULTIPLY  &kp KP_N7  &kp KP_N8  &kp KP_N9  &kp KP_MINUS  &trans
&trans  &trans  &trans  &trans  &trans  &trans                          &kp KP_DIVIDE    &kp KP_N4  &kp KP_N5  &kp KP_N6  &kp KP_PLUS   &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans        &kp KP_NUMLOCK   &kp KP_N1  &kp KP_N2  &kp KP_N3  &kp KP_DOT    &trans
                &trans  &trans  &trans  &trans  &trans    &kp KP_ENTER  &kp KP_N0        &trans     &trans     &trans
            >;
        };

        Numpad2 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                          &trans           &trans     &trans     &trans     &trans        &trans
&tog 7  &trans  &trans  &trans  &trans  &trans                          &kp KP_MULTIPLY  &kp KP_N7  &kp KP_N8  &kp KP_N9  &kp KP_MINUS  &trans
&trans  &trans  &trans  &trans  &trans  &trans                          &kp KP_DIVIDE    &kp KP_N4  &kp KP_N5  &kp KP_N6  &kp KP_PLUS   &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans        &kp KP_NUMLOCK   &kp KP_N1  &kp KP_N2  &kp KP_N3  &kp COMMA     &trans
                &trans  &trans  &trans  &trans  &trans    &kp KP_ENTER  &kp KP_N0        &trans     &trans     &trans
            >;
        };

        Meta {
            bindings = <
&trans  &trans  &trans          &trans    &trans  &trans                    &trans          &trans  &trans      &trans          &trans           &trans
&trans  &trans  &trans          &trans    &trans  &trans                    &trans          &trans  &kp INSERT  &trans          &kp PAUSE_BREAK  &trans
&trans  &trans  &kp SCROLLLOCK  &trans    &trans  &tog 1                    &trans          &trans  &trans      &kp SCROLLLOCK  &trans           &trans
&trans  &trans  &trans          &kp CAPS  &trans  &trans  &trans    &trans  &kp KP_NUMLOCK  &trans  &tog 7      &trans          &trans           &trans
                &trans          &trans    &trans  &trans  &trans    &trans  &trans          &trans  &trans      &trans
            >;
        };
    };

    conditional_layers { compatible = "zmk,conditional-layers"; };
};

&sensors { triggers-per-rotation = <30>; };

&left_encoder { steps = <60>; };

&right_encoder { steps = <60>; };
